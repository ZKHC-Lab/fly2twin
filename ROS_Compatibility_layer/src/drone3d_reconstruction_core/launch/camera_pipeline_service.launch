<?xml version="1.0"?>
<!--
  Camera pipeline upper-layer service launch entry.

  front_capture_profile / down_capture_profile must be the SAME capture
  profile files passed to capture_production.launch for the front/down roles.
  They are loaded into the service node's private `roles/` namespace so the
  service only orchestrates already-configured data sources.

  The service never starts a ROS master, never subscribes to images, never
  reads bags, and never starts a CUDA worker itself.
-->
<launch>
  <arg name="front_capture_profile"
       doc="Absolute path to the front camera capture profile YAML" />
  <arg name="down_capture_profile"
       doc="Absolute path to the down camera capture profile YAML" />
  <arg name="pipeline_profile"
       doc="Absolute path to the pipeline runtime profile YAML" />
  <arg name="required" default="true" />
  <arg name="node_name" default="camera_pipeline_service" />
  <arg name="ns" default="camera_pipeline"
       doc="Namespace without leading slash for the service node group" />

  <group ns="$(arg ns)">
    <rosparam command="load" file="$(arg front_capture_profile)"
              ns="/$(arg ns)/$(arg node_name)/roles/front" />
    <rosparam command="load" file="$(arg down_capture_profile)"
              ns="/$(arg ns)/$(arg node_name)/roles/down" />
    <rosparam command="load" file="$(arg pipeline_profile)"
              ns="/$(arg ns)/$(arg node_name)" />
    <node name="$(arg node_name)"
          pkg="drone3d_reconstruction_core"
          type="camera_pipeline_service_node.py"
          output="screen"
          required="$(arg required)" />
  </group>
</launch>
