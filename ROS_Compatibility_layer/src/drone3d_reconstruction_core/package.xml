<?xml version="1.0"?>
<package format="2">
  <name>drone3d_reconstruction_core</name>
  <version>0.1.0</version>
  <description>Worker lifecycle and low-level ROS Action arbitration for Drone3D reconstruction.</description>
  <maintainer email="maintainer@example.invalid">Drone3D Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>drone3d_runtime</depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>drone3d_reconstruction_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>python3</exec_depend>
  <exec_depend version_gte="1.20">python3-numpy</exec_depend>
  <exec_depend version_gte="1.7">python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
