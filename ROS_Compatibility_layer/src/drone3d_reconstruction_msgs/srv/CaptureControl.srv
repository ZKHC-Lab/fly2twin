# Per-role CaptureSegment pause/resume control.
#
# PAUSE keeps the current window and its stamp baseline but stops adding
# selected frames; RESUME continues the same window. This service never
# cancels or discards the active capture goal.
uint8 PAUSE=0
uint8 RESUME=1

uint8 command
---
int32 OK=0
int32 INVALID_COMMAND=1
int32 NO_ACTIVE_SESSION=2
int32 INTERNAL_ERROR=3

int32 error_code
string message
bool paused
