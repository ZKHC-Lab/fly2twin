# Upper-layer camera pipeline service command.
#
# The service only orchestrates the existing CaptureSegment and
# ReconstructSegment Actions. It never opens bags, publishes images, or
# executes a reconstruction worker itself.

uint8 SELECT_SOURCE = 0
uint8 START_TASK = 1
uint8 GET_STATUS = 2
uint8 CANCEL_TASK = 3

uint8 command

# SELECT_SOURCE: required. START_TASK: optional; empty means use the selected
# role. GET_STATUS/CANCEL_TASK ignore this field.
string role

# START_TASK fields. scene_id must be a safe identifier; sample_fps,
# max_frames, and max_duration_sec must satisfy the selected role's capture
# profile bounds.
string scene_id
float32 sample_fps
uint32 max_frames
float32 max_duration_sec
---
int32 OK=0
int32 INVALID_COMMAND=1
int32 UNKNOWN_ROLE=2
int32 BUSY=3
int32 NO_TASK=4
int32 TASK_FAILED=5
int32 INTERNAL_ERROR=6
int32 NOT_READY=7
int32 INVALID_ARGUMENT=8

int32 error_code
string message
string role
string state

# Monotonic task id inside this service process; 0 when no task has started.
uint32 task_id
string scene_id

string capture_action
string reconstruct_action

string snapshot_uri
string manifest_sha256
string result_manifest_uri
string result_manifest_sha256

uint32 captured_frames
uint32 reconstruction_frames
float32 reconstruction_progress
string reconstruction_stage

string last_error
duration task_wall_time
